# docker-compose.prod.yml settings. Copy to .env.prod (not committed) and pass it with --env-file .env.prod.
# The app's own settings (secrets, email, SMS, S3 ...) are in backend/.env.prod (see backend/.env.prod.example).

# ---- Domains (Caddy gets certificates for each; point their DNS A/AAAA records at the server first)
WEB_DOMAIN=instantmechanic.online
ADMIN_DOMAIN=admin.instantmechanic.online
API_DOMAIN=api.instantmechanic.online
# Customer photo uploads to SeaweedFS (profile `storage`). Must match S3_PUBLIC_ENDPOINT_URL in backend/.env.prod.
FILES_DOMAIN=files.instantmechanic.online
# Local test (README Phase 5.1): WEB_DOMAIN=localhost API_DOMAIN=localhost:8443 ADMIN_DOMAIN=localhost:8444
# FILES_DOMAIN=localhost:8445 (ports, not subdomains: see docker-compose.prod.local.yml), CADDY_TLS=internal.
# Email for Let's Encrypt / ZeroSSL notices.
CADDY_TLS=ops@example.com
# Strict-Transport-Security max-age in seconds (0 for the local test on localhost)
HSTS_MAX_AGE=31536000
# Host ports Caddy listens on (keep 80 and 443 in production: certificates need them)
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database (its own volume, autocare-prod_pgdata_prod). Use a long URL-safe password, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_USER=autocare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autocare

# ---- Build-time settings (baked into the images: rebuild after changing them)
# Embedding model downloaded into the API / worker image. A Hugging Face id; keep it the same as EMBEDDING_MODEL in
# backend/.env.prod.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Admin map tiles (Requests and Mechanics pages). OpenStreetMap's public tiles do not allow production traffic: set a
# tile provider and its attribution. NEXT_PUBLIC_API_URL is https://API_DOMAIN for both apps.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ---- Data mounted into the API / worker (not in the images). Paths on the server.
DATA_RAW_DIR=./data/raw
DATA_MEDIA_DIR=./data/media

# ---- Image names (e.g. a registry path); defaults autocare-api / autocare-web / autocare-admin:latest
# API_IMAGE=autocare-api:latest
# WEB_IMAGE=autocare-web:latest
# ADMIN_IMAGE=autocare-admin:latest
