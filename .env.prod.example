# docker-compose.prod.yml settings. Copy to .env.prod (not committed) and pass it with --env-file .env.prod.
# The app's own settings (secrets, email, SMS, S3 ...) are in backend/.env.prod (see backend/.env.prod.example).

# ---- Domains (Caddy gets certificates for each; point their DNS A records at the server first: docs/server-setup.md)
# Production defaults below. instantmechanic.online itself stays on the company's existing site. Staging uses its own,
# e.g. diagnose.staging.instantmechanic.online, admin.staging..., api.staging..., files.staging...
# From these the API gets WEB_ORIGIN, ADMIN_ORIGIN (CORS, cookies) and S3_PUBLIC_ENDPOINT_URL (photo links), and the
# web and admin images get NEXT_PUBLIC_API_URL / NEXT_PUBLIC_FILES_URL (their CSP): docker-compose.prod.yml.
WEB_DOMAIN=diagnose.instantmechanic.online
ADMIN_DOMAIN=admin.instantmechanic.online
API_DOMAIN=api.instantmechanic.online
# Customer photo uploads to SeaweedFS (profile `storage`).
FILES_DOMAIN=files.instantmechanic.online
# Local test (README Phase 5.1): WEB_DOMAIN=localhost API_DOMAIN=localhost:8443 ADMIN_DOMAIN=localhost:8444
# FILES_DOMAIN=localhost:8445 (ports, not subdomains: see docker-compose.prod.local.yml), CADDY_TLS=internal.
# Email for Let's Encrypt / ZeroSSL notices.
CADDY_TLS=ops@example.com
# Strict-Transport-Security max-age in seconds (0 for the local test on localhost)
HSTS_MAX_AGE=31536000
# Host ports Caddy listens on (keep 80 and 443 in production: certificates need them)
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database (its own volume, autocare-prod_pgdata_prod). Use a long URL-safe password, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_USER=autocare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autocare

# ---- Build-time settings (baked into the images: rebuild after changing them)
# Embedding model downloaded into the API / worker image. A Hugging Face id; keep it the same as EMBEDDING_MODEL in
# backend/.env.prod.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Admin map tiles: see NEXT_PUBLIC_MAP_PROVIDER below. NEXT_PUBLIC_MAP_TILE_URL / _ATTRIBUTION = any other XYZ
# provider (NEXT_PUBLIC_MAP_PROVIDER=custom). NEXT_PUBLIC_API_URL is https://API_DOMAIN for both apps.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ---- Data mounted into the API / worker (not in the images). Paths on the server.
DATA_RAW_DIR=./data/raw
DATA_MEDIA_DIR=./data/media

# ---- Image names; defaults autocare-api / -web / -admin / -backup:latest (built on this machine). Servers deployed by
# GitHub Actions (Phase 5.6) do not set these here: scripts/deploy/remote-deploy.sh passes the GHCR image of the commit
# (ghcr.io/<owner>/autocare-api:<commit sha> ...).
# API_IMAGE=autocare-api:latest
# WEB_IMAGE=autocare-web:latest
# ADMIN_IMAGE=autocare-admin:latest
# BACKUP_IMAGE=autocare-backup:latest

# ---- Phase 5.4 (build-time values for the web and admin images: rebuild after changing them)
# Where browsers upload photos and load signed photo links (the CSP allows it). Default: https://FILES_DOMAIN.
# NEXT_PUBLIC_FILES_URL=
# Cloudflare Turnstile site key (public). Empty = no "I'm human" widget (set TURNSTILE_SECRET_KEY in
# backend/.env.prod with it).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry for the browsers (public DSN; empty = off) and the environment name for both apps and the API
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Admin map tiles: stadia (default) or maptiler, with the provider's key (README "Phase 5.4": which to sign up for)
NEXT_PUBLIC_MAP_PROVIDER=stadia
NEXT_PUBLIC_MAP_KEY=

# ---- Backups (docs/runbooks/restore.md)
# The age PUBLIC key ("age1..."); the private key stays off this server. Empty = no backups (logged).
BACKUP_AGE_RECIPIENT=
# Off-site copy: an S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3 ...) as rclone remote "offsite".
# BACKUP_REMOTE = offsite:<bucket>/<folder>. Empty = local copies only (logged).
BACKUP_REMOTE=
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
BACKUP_RETENTION_DAYS=30
# Daily, UTC (21:00 = 02:30 India time)
BACKUP_AT=21:00
