# Copy to .env.local. Variables starting with NEXT_PUBLIC_ are sent to the browser.
# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the browser uploads photos and loads signed photo links (the CSP allows only this): the local SeaweedFS.
NEXT_PUBLIC_FILES_URL=http://localhost:8333
# Cloudflare Turnstile site key. Empty = no widget. Cloudflare's test key (always passes, no puzzle):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   (with TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry for the browser (public DSN). Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
# Free demo (docs/deploy-free-demo.md). API_PROXY_TARGET: the API's origin (e.g. https://im-api.onrender.com); /api/*
# and /media/* on this site are rewritten there, so cookies are first-party and NEXT_PUBLIC_API_URL is ignored.
# Build-time and server-only. Empty = call NEXT_PUBLIC_API_URL directly (docker-compose, local).
API_PROXY_TARGET=
# 1 = the Demo banner on every page and noindex.
NEXT_PUBLIC_DEMO=
