# Copy to .env.local. Variables starting with NEXT_PUBLIC_ are sent to the browser.
# Base URL of the FastAPI backend (its ADMIN_ORIGIN must be this app's address, http://localhost:3001).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Map tiles (Requests and Mechanics pages). Empty = OpenStreetMap's public tiles, for development only: their usage
# policy does not allow production traffic, so production sets a proper tile provider here, with its attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
