# Copy to .env.local. Variables starting with NEXT_PUBLIC_ are sent to the browser.
# Base URL of the FastAPI backend (its ADMIN_ORIGIN must be this app's address, http://localhost:3001).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Map tiles (Requests and Mechanics pages): stadia (default; works on localhost without a key) or maptiler (needs a
# key), with the provider's key. Or custom: NEXT_PUBLIC_MAP_TILE_URL and NEXT_PUBLIC_MAP_ATTRIBUTION.
NEXT_PUBLIC_MAP_PROVIDER=stadia
NEXT_PUBLIC_MAP_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_FILES_URL=http://localhost:8333
# Sentry for the browser (public DSN). Empty = off.
NEXT_PUBLIC_SENTRY_DSN=
# Free demo (docs/deploy-free-demo.md): the API's origin; /api/* and /media/* on this site are rewritten there.
API_PROXY_TARGET=
# 1 = the Demo banner on every page (the admin app is always noindex).
NEXT_PUBLIC_DEMO=
