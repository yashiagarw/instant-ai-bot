{
  "name": "autocare-ai",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin dev",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm --filter web --filter admin build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web --filter admin test:e2e",
    "test:security": "sh scripts/security-scan.sh",
    "test:all": "sh scripts/test-all.sh"
  }
}
