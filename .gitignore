.DS_Store
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/

# Secrets: real env files stay local. The *.example files are committed.
.env
.env.*
!.env.example

# Node / Next.js (apps/web has its own .gitignore too)
node_modules/
.next/
coverage/
*.tsbuildinfo

# Pictures extracted by the importer (regenerate: cd backend && uv run python -m app.knowledge.importer --all)
data/media/

# Dataset files uploaded on the admin Datasets page (kept so versions can be rebuilt and rolled back)
data/uploads/

# Fine-tuned embedding models (hundreds of MB; rebuild with `cd backend && uv run --extra train python -m
# app.knowledge.finetune train`, see docs/embedding-model.md)
data/models/
