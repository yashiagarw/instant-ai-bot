# Copy to backend/.env. Never commit .env.
ENVIRONMENT=development
# Must match the root .env used by docker compose.
DATABASE_URL=postgresql+psycopg://autocare:autocare@localhost:5432/autocare
# pytest only. Tests drop and recreate everything in this database.
TEST_DATABASE_URL=postgresql+psycopg://autocare:autocare@localhost:5432/autocare_test
# The only origin CORS allows: the customer web app.
WEB_ORIGIN=http://localhost:3000
# The staff admin app (apps/admin). Also allowed by CORS; staff cookies are only sent to /api/admin.
ADMIN_ORIGIN=http://localhost:3001
DB_CONNECT_TIMEOUT=3
# Free-text matching: hybrid (full-text + vectors + typo correction over the embeddings table; loads the local
# multilingual MiniLM model, about 470 MB, at first use) or keyword (no model). Run
# `uv run python -m app.knowledge.embeddings sync` after importing data.
DIAGNOSIS_SEARCH=hybrid
# Diagnosis engine: v2 (default: Bayesian posterior over faults, next question by information gain) or v1.
DIAGNOSIS_ENGINE=v2
# Embedding model for search vectors. Default: the original multilingual MiniLM. A fine-tuned model is a folder name in
# data/models (e.g. minilm-im-v1). It applies to new dataset builds only: build a draft on the Datasets page, run the
# eval and publish it to switch (docs/embedding-model.md).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=none is LITE mode (the free demo, docs/deploy-free-demo.md): torch and the model are never loaded;
# search uses full text, spelling variants and Hinglish forms only. Install without them: uv sync --no-group embeddings

# Free demo switches (docs/deploy-free-demo.md); the defaults are the normal docker-compose deployment.
# worker (the arq worker runs notifications, dispatch, retention) or api (they run inside the API process).
BACKGROUND_JOBS=worker
# false: dataset upload, rebuild, eval and publish answer 503 with a message (no worker to run them).
DATASET_JOBS_ENABLED=true
# false: no customer photo upload (the step is hidden; no storage needed).
PHOTO_UPLOADS_ENABLED=true
# false: no fault or part picture links (the server has no data/media).
SHOW_PICTURES=true
# New diagnosis sessions allowed per client IP per window (seconds).
SESSION_RATE_LIMIT=10
SESSION_RATE_WINDOW_SECONDS=60
# Trust X-Forwarded-For for the client IP. Only behind your own reverse proxy.
TRUST_FORWARDED_FOR=false
# ---- Dataset publish pipeline (admin Datasets page): background jobs via Redis (docker compose up -d redis) and the
# worker (cd backend && uv run arq app.datasets.worker.WorkerSettings). Uploaded files are kept in DATASET_UPLOAD_DIR.
REDIS_URL=redis://localhost:6379/0
# DATASET_UPLOAD_DIR=../data/uploads/datasets
DATASET_UPLOAD_MAX_MB=25
# Real cases added to the eval golden set from the admin Quality page (default below; one YAML file per case)
# GOLDEN_CASES_DIR=../data/eval/golden/real_cases
# ---- LLM
# LLM_PROVIDER: none (default: no LLM calls; the app works fully with its non-LLM fallbacks), anthropic (the
# live LLM layer: free-text extraction and question phrasing; runs only when ANTHROPIC_API_KEY is set) or openai
# (offline question drafting only). Offline drafting (python -m app.knowledge.questions) can also take --provider.
LLM_PROVIDER=none
# Placeholder: paste a real key here to switch the live layer on (with LLM_PROVIDER=anthropic). Never commit it.
ANTHROPIC_API_KEY=
# Live layer models (must have a price in app/llm/pricing.py), effort, timeout and the daily spend cap (USD,
# estimated, resets at midnight India time; once reached every LLM step falls back).
LLM_EXTRACTION_MODEL=claude-haiku-5-5
LLM_PHRASING_MODEL=claude-haiku-5-5
LLM_EXPLANATION_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=4
# Photo analysis (warning lights, visible damage). Same switch: runs only with LLM_PROVIDER=anthropic and a key;
# otherwise no call is made and the photo is kept for the mechanic.
LLM_VISION_MODEL=claude-opus-5-5
LLM_VISION_TIMEOUT_SECONDS=20
VISION_MIN_CONFIDENCE=0.6
LLM_DAILY_SPEND_CAP_USD=2
# Offline question drafting (anthropic)
QUESTIONS_MODEL=claude-opus-5-5
QUESTIONS_EFFORT=high
# OpenAI. OPENAI_MODEL is required when LLM_PROVIDER=openai (no default). Reasoning effort is optional.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
# USD per million tokens for the run-log cost estimate (leave 0 to log tokens only).
OPENAI_PRICE_INPUT_PER_M=0
OPENAI_PRICE_CACHED_INPUT_PER_M=0
OPENAI_PRICE_OUTPUT_PER_M=0

# Folder with the fault pictures served at /media (default: <repo>/data/media).
# MEDIA_DIR=../data/media

# ---- Request a Mechanic
# Helpline shown to customers on the request form and confirmation. Placeholder: set the real number.
HELPLINE_NUMBER=+91-00000-00000
# New requests are emailed to this address. Placeholder: set the support inbox.
SUPPORT_EMAIL=support@example.com
# console (default: prints the email in the API log), smtp or resend
EMAIL_PROVIDER=console
EMAIL_FROM="Instant Mechanic <alerts@example.com>"
# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# At most N new requests per IP per window
REQUEST_RATE_LIMIT=5
REQUEST_RATE_WINDOW_SECONDS=600

# ---- Customer accounts (phone + OTP login)
# Keys the OTP hashes. Development default works locally; in production set a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   (the API refuses to start without one)
AUTH_SECRET=dev-only-auth-secret-change-me
# console (default: prints the login code in the API terminal; refused when ENVIRONMENT=production) or msg91
SMS_PROVIDER=console
# MSG91 (SMS_PROVIDER=msg91). Placeholders: no account yet. See README "Going live with MSG91".
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# Code lifetime, tries per code, and limits (codes per phone per window, requests / checks per IP per window)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT=3
OTP_PHONE_WINDOW_SECONDS=900
OTP_IP_LIMIT=10
OTP_IP_WINDOW_SECONDS=3600
OTP_VERIFY_IP_LIMIT=20
OTP_VERIFY_IP_WINDOW_SECONDS=900
AUTH_SESSION_DAYS=30
# Login cookies are HttpOnly, SameSite=Lax and Secure. Chrome and Firefox accept Secure cookies on
# http://localhost; set false only if your browser does not (never in production).
COOKIE_SECURE=true
# Staff login (/api/admin). STAFF_TOTP_KEY encrypts two-factor secrets; required in production. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes every staff member set up two-factor again.
STAFF_TOTP_KEY=change-me
# Mechanics' ID documents are encrypted with MECHANIC_DOCS_KEY (a Fernet key, generated as above; NOT the same as
# STAFF_TOTP_KEY). Without it document uploads are refused. Losing or changing it makes stored documents unreadable.
MECHANIC_DOCS_KEY=change-me
MECHANIC_DOC_MAX_MB=10
STAFF_SESSION_HOURS=8
STAFF_IDLE_MINUTES=30
STAFF_MAX_FAILED_LOGINS=5
STAFF_LOCKOUT_MINUTES=15
STAFF_LOGIN_IP_LIMIT=20
STAFF_LOGIN_IP_WINDOW_SECONDS=900
# Files customers upload (none yet), one folder per user, deleted with the account (default: <repo>/data/uploads)
# UPLOADS_DIR=../data/uploads

# ---- Customer photos (S3-compatible storage: the `storage` service in docker-compose for development, any S3 in
# production). Placeholders: put your own key pair in backend/.env (never commit real keys); the local storage
# container reads the same S3_ACCESS_KEY / S3_SECRET_KEY from backend/.env.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# Where the API reaches the storage, and the address browsers use for presigned uploads (same locally)
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=ap-south-1
# Private bucket: created by `uv run python -m app.uploads.storage setup`
S3_BUCKET=autocare-uploads
# Photo limits and signed-link lifetimes
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PX=2000
UPLOAD_URL_TTL_SECONDS=600
UPLOAD_VIEW_TTL_SECONDS=300
UPLOADS_PER_SESSION=5
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=600

# ---- Notifications (Phase 5.2; docs/notifications-setup.md lists the accounts and templates to set up)
# Request events notify the support inbox (email), the mechanic (job offers) and the customer (assigned, on the
# way, arrived, done) through the worker, with retries. Channels are tried in this order, skipping those a person has
# not agreed to (WhatsApp needs an opt-in) or turned off; a channel that is not set up falls back to the next one.
NOTIFY_CUSTOMER_CHANNELS=whatsapp,push,sms
NOTIFY_MECHANIC_CHANNELS=whatsapp,sms
NOTIFY_SUPPORT_CHANNELS=email
# Job offers to mechanics: en or hi (customers get the language of their diagnosis, else en)
NOTIFY_MECHANIC_LANGUAGE=en
# Temporary errors are retried: attempts per channel, and the first wait in seconds (then x4: 30 s, 2 min, 8 min)
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_RETRY_BASE_SECONDS=30
# SMS notifications use SMS_PROVIDER and the MSG91 keys above, with one MSG91 template id per DLT-approved template.
# Empty = that SMS is skipped (a missing Hindi id falls back to the English SMS).
MSG91_TPL_JOB_OFFER_EN=
MSG91_TPL_JOB_OFFER_HI=
MSG91_TPL_MECHANIC_ASSIGNED_EN=
MSG91_TPL_MECHANIC_ASSIGNED_HI=
MSG91_TPL_MECHANIC_EN_ROUTE_EN=
MSG91_TPL_MECHANIC_EN_ROUTE_HI=
MSG91_TPL_MECHANIC_ARRIVED_EN=
MSG91_TPL_MECHANIC_ARRIVED_HI=
MSG91_TPL_JOB_COMPLETED_EN=
MSG91_TPL_JOB_COMPLETED_HI=
# WhatsApp: console (prints; refused in production) or cloud (Meta WhatsApp Cloud API). Placeholders: no account yet.
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Checks X-Hub-Signature-256 on POST /api/webhooks/whatsapp (Meta app secret) and the GET verification token
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Approved template names (English "en" and Hindi "hi" translations each); empty = WhatsApp skipped for that message
WHATSAPP_TPL_JOB_OFFER=
WHATSAPP_TPL_MECHANIC_ASSIGNED=
WHATSAPP_TPL_MECHANIC_EN_ROUTE=
WHATSAPP_TPL_MECHANIC_ARRIVED=
WHATSAPP_TPL_JOB_COMPLETED=
# Browser alerts (web push): console (prints) or webpush. Keys: uv run python -m app.notify.push keys
# (no public key = the "Turn on alerts" button is hidden). Keep the pair: a new one means turning alerts on again.
PUSH_PROVIDER=console
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ---- Mechanic app and dispatch (Phase 5.3)
# An open offer expires after this many seconds (then auto-offer, where it is on, offers the next suggestion); a
# request nobody has accepted this long after its first offer is escalated to support. Checked by the worker every 20 s.
OFFER_EXPIRY_SECONDS=180
DISPATCH_ESCALATE_SECONDS=600
# Mechanic app (/m) sign-in length
MECHANIC_SESSION_DAYS=30
# Masked calls between customer and mechanic: console (prints, development; refused in production) or exotel.
# Placeholders: no Exotel account yet (docs/notifications-setup.md, "Masked calls").
CALL_PROVIDER=console
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.exotel.com (Singapore cluster) or api.in.exotel.com (Mumbai), as shown in your Exotel API settings
EXOTEL_SUBDOMAIN=api.exotel.com
# The ExoPhone (virtual number) both people see, e.g. 011XXXXXXXX
EXOTEL_CALLER_ID=
CALL_TIME_LIMIT_SECONDS=900
CALL_RATE_LIMIT=5
CALL_RATE_WINDOW_SECONDS=600

# ---- Production hardening (Phase 5.4)
# Logs: json (one object per line, the default) or console (plain text for reading locally). Phone numbers, emails
# and number plates are masked in every line; each line has the request id.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Sentry (errors only, personal data scrubbed, no session replay). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Rate limits counted in Redis (REDIS_URL) across API processes; "memory" = per process. Redis down = memory.
RATE_LIMIT_BACKEND=redis
# Backstop for every /api call per client IP per window (endpoints keep their own tighter limits)
GLOBAL_RATE_LIMIT=600
GLOBAL_RATE_WINDOW_SECONDS=60
# Request bodies above this are refused (413), except the upload endpoints (their own limits)
API_MAX_BODY_BYTES=262144
# Cloudflare Turnstile on public forms (request form, login codes). Empty = off. Cloudflare's test secrets:
#   1x0000000000000000000000000000000AA always passes, 2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=
# Retention (the worker, daily 03:00 India time): days before personal data is removed
RETENTION_LOCATION_DAYS=90
RETENTION_LLM_DAYS=30
RETENTION_REPLAY_DAYS=90
RETENTION_WHATSAPP_INBOUND_DAYS=30
