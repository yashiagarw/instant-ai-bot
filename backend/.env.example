# Copy to backend/.env. Never commit .env.
ENVIRONMENT=development
# Must match the root .env used by docker compose.
DATABASE_URL=postgresql+psycopg://autocare:autocare@localhost:5432/autocare
# pytest only. Tests drop and recreate everything in this database.
TEST_DATABASE_URL=postgresql+psycopg://autocare:autocare@localhost:5432/autocare_test
# The only origin CORS allows: the customer web app.
WEB_ORIGIN=http://localhost:3000
DB_CONNECT_TIMEOUT=3
# Free-text matching: hybrid (full-text + vectors + typo correction over the embeddings table; loads the local
# multilingual MiniLM model, about 470 MB, at first use) or keyword (no model). Run
# `uv run python -m app.knowledge.embeddings sync` after importing data.
DIAGNOSIS_SEARCH=hybrid
# Diagnosis engine: v2 (default: Bayesian posterior over faults, next question by information gain) or v1.
DIAGNOSIS_ENGINE=v2
# New diagnosis sessions allowed per client IP per window (seconds).
SESSION_RATE_LIMIT=10
SESSION_RATE_WINDOW_SECONDS=60
# Trust X-Forwarded-For for the client IP. Only behind your own reverse proxy.
TRUST_FORWARDED_FOR=false
# ---- LLM
# LLM_PROVIDER: none (default: no LLM calls; the app works fully with its non-LLM fallbacks), anthropic (the
# live LLM layer: free-text extraction and question phrasing; runs only when ANTHROPIC_API_KEY is set) or openai
# (offline question drafting only). Offline drafting (python -m app.knowledge.questions) can also take --provider.
LLM_PROVIDER=none
# Placeholder: paste a real key here to switch the live layer on (with LLM_PROVIDER=anthropic). Never commit it.
ANTHROPIC_API_KEY=
# Live layer models (must have a price in app/llm/pricing.py), effort, timeout and the daily spend cap (USD,
# estimated, resets at midnight India time; once reached every LLM step falls back).
LLM_EXTRACTION_MODEL=claude-haiku-5-5
LLM_PHRASING_MODEL=claude-haiku-5-5
LLM_EXPLANATION_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=4
LLM_DAILY_SPEND_CAP_USD=2
# Offline question drafting (anthropic)
QUESTIONS_MODEL=claude-opus-5-5
QUESTIONS_EFFORT=high
# OpenAI. OPENAI_MODEL is required when LLM_PROVIDER=openai (no default). Reasoning effort is optional.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
# USD per million tokens for the run-log cost estimate (leave 0 to log tokens only).
OPENAI_PRICE_INPUT_PER_M=0
OPENAI_PRICE_CACHED_INPUT_PER_M=0
OPENAI_PRICE_OUTPUT_PER_M=0

# Folder with the fault pictures served at /media (default: <repo>/data/media).
# MEDIA_DIR=../data/media

# ---- Request a Mechanic
# Helpline shown to customers on the request form and confirmation. Placeholder: set the real number.
HELPLINE_NUMBER=+91-00000-00000
# New requests are emailed to this address. Placeholder: set the support inbox.
SUPPORT_EMAIL=support@example.com
# console (default: prints the email in the API log), smtp or resend
EMAIL_PROVIDER=console
EMAIL_FROM="Instant Mechanic <alerts@example.com>"
# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# At most N new requests per IP per window
REQUEST_RATE_LIMIT=5
REQUEST_RATE_WINDOW_SECONDS=600
