# Production settings for the API, the worker and the one-off jobs (docker-compose.prod.yml). Copy to
# backend/.env.prod (not committed) and replace every placeholder. Placeholders only: never put real values here.
# Set by docker-compose.prod.yml, not here: DATABASE_URL and REDIS_URL (from the root .env.prod), ENVIRONMENT=production,
# TRUST_FORWARDED_FOR=true (Caddy sets X-Forwarded-For).
# Every other variable of backend/.env.example works here too, with the same defaults.

# ---- Origins (CORS, cookies). The browser calls the API at https://API_DOMAIN from these two.
WEB_ORIGIN=https://instantmechanic.online
ADMIN_ORIGIN=https://admin.instantmechanic.online
COOKIE_SECURE=true

# ---- Secrets (required in production: the API refuses to start without valid ones)
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me-to-a-long-random-value
# Fernet keys, two different ones: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STAFF_TOTP_KEY=change-me
MECHANIC_DOCS_KEY=change-me

# ---- Search
DIAGNOSIS_SEARCH=hybrid
DIAGNOSIS_ENGINE=v2
# Must be the model baked into the image (EMBEDDING_MODEL in the root .env.prod).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Customer photos (S3). Single server: SeaweedFS (profile `storage`) behind Caddy at FILES_DOMAIN.
# A cloud bucket later (AWS S3, Cloudflare R2 ...): set the endpoint(s), region, bucket and key pair to it, leave the
# `storage` profile off, and run `--profile setup run --rm setup` once (creates the bucket rules and its CORS).
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# Where the API reaches the storage (inside the compose network)
S3_ENDPOINT_URL=http://storage:8333
# The address in presigned links given to browsers: https://FILES_DOMAIN (or the cloud bucket's endpoint)
S3_PUBLIC_ENDPOINT_URL=https://files.instantmechanic.online
S3_REGION=ap-south-1
S3_BUCKET=autocare-uploads

# ---- Request a Mechanic
HELPLINE_NUMBER=+91-00000-00000
SUPPORT_EMAIL=support@example.com
EMAIL_PROVIDER=smtp
EMAIL_FROM="Instant Mechanic <alerts@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESEND_API_KEY=

# ---- Customer login codes (console is refused in production)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ---- LLM layer (off unless anthropic + a key)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=

# ---- Notifications (Phase 5.2; docs/notifications-setup.md lists the accounts and templates to set up)
# Request events notify the support inbox (email), the mechanic (job offers) and the customer (assigned, on the
# way, arrived, done) through the worker, with retries. Channels are tried in this order, skipping those a person has
# not agreed to (WhatsApp needs an opt-in) or turned off; a channel that is not set up falls back to the next one.
NOTIFY_CUSTOMER_CHANNELS=whatsapp,push,sms
NOTIFY_MECHANIC_CHANNELS=whatsapp,sms
NOTIFY_SUPPORT_CHANNELS=email
# Job offers to mechanics: en or hi (customers get the language of their diagnosis, else en)
NOTIFY_MECHANIC_LANGUAGE=en
# Temporary errors are retried: attempts per channel, and the first wait in seconds (then x4: 30 s, 2 min, 8 min)
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_RETRY_BASE_SECONDS=30
# SMS notifications use SMS_PROVIDER and the MSG91 keys above, with one MSG91 template id per DLT-approved template.
# Empty = that SMS is skipped (a missing Hindi id falls back to the English SMS).
MSG91_TPL_JOB_OFFER_EN=
MSG91_TPL_JOB_OFFER_HI=
MSG91_TPL_MECHANIC_ASSIGNED_EN=
MSG91_TPL_MECHANIC_ASSIGNED_HI=
MSG91_TPL_MECHANIC_EN_ROUTE_EN=
MSG91_TPL_MECHANIC_EN_ROUTE_HI=
MSG91_TPL_MECHANIC_ARRIVED_EN=
MSG91_TPL_MECHANIC_ARRIVED_HI=
MSG91_TPL_JOB_COMPLETED_EN=
MSG91_TPL_JOB_COMPLETED_HI=
# WhatsApp: cloud once the Meta account and templates are approved (console is refused in production: skipped).
WHATSAPP_PROVIDER=cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Checks X-Hub-Signature-256 on POST /api/webhooks/whatsapp (Meta app secret) and the GET verification token
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Approved template names (English "en" and Hindi "hi" translations each); empty = WhatsApp skipped for that message
WHATSAPP_TPL_JOB_OFFER=
WHATSAPP_TPL_MECHANIC_ASSIGNED=
WHATSAPP_TPL_MECHANIC_EN_ROUTE=
WHATSAPP_TPL_MECHANIC_ARRIVED=
WHATSAPP_TPL_JOB_COMPLETED=
# Browser alerts (web push): console (prints) or webpush. Keys: uv run python -m app.notify.push keys
# (no public key = the "Turn on alerts" button is hidden). Keep the pair: a new one means turning alerts on again.
PUSH_PROVIDER=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@instantmechanic.online
